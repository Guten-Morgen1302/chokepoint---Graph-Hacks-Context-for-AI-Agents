# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# How to get each value: docs/ENV_SETUP.md

# ── LLM (the agent) ─────────────────────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional alternative: LLM_PROVIDER=anthropic + ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ── FalkorDB ────────────────────────────────────────────────────
# Local docker: localhost / 6379 and leave user+password empty.
# FalkorDB Cloud: copy host, port, username, password from the instance page.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# ── App ─────────────────────────────────────────────────────────
# Long random string; signs visitor cookies.
CHOKEPOINT_SECRET=change-me
# Optional: enables /admin?token=...
CHOKEPOINT_ADMIN_TOKEN=

# ── Demo limits (defaults are fine) ─────────────────────────────
CHOKEPOINT_MAX_GRAPHS=50
CHOKEPOINT_IP_GRAPHS_PER_HOUR=5
CHOKEPOINT_RUNS_PER_HOUR=10
CHOKEPOINT_RUNS_PER_DAY=300
